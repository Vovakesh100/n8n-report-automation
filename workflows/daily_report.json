{
  "name": "Daily sales report",
  "nodes": [
    {
      "parameters": {},
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "fileSelector": "/data/sample_sales.csv"
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Read CSV",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "command": "uv run python -m report.cli /data/sample_sales.csv"
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Run Report CLI",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const summaries = JSON.parse($input.first().json.stdout);\nconst lines = summaries.map((s) => {\n  const total = (s.total_revenue_cents / 100).toFixed(2);\n  return `${s.date}: revenue ${total}, orders ${s.orders}, top product ${s.top_product}`;\n});\nreturn [{ json: { text: ['Daily sales report', ...lines].join('\\n') } }];"
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_TELEGRAM_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 0],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "REPLACE_WITH_TELEGRAM_CREDENTIAL_NAME"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Read CSV", "type": "main", "index": 0 }]]
    },
    "Read CSV": {
      "main": [[{ "node": "Run Report CLI", "type": "main", "index": 0 }]]
    },
    "Run Report CLI": {
      "main": [[{ "node": "Format Message", "type": "main", "index": 0 }]]
    },
    "Format Message": {
      "main": [[{ "node": "Send Telegram", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
