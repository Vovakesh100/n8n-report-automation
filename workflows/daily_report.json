{
  "name": "Daily sales report",
  "nodes": [
    {
      "parameters": {},
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 9 * * *" }]
        }
      },
      "id": "66666666-6666-4666-8666-666666666666",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "command": "=PYTHONPATH=/app/src python3 -m report.cli '{{ $env.REPORT_CSV_PATH || '/data/sample_sales.csv' }}'{{ $env.REPORT_FROM ? \" --from '\" + String($env.REPORT_FROM).replace(/'/g, '') + \"'\" : '' }}{{ $env.REPORT_TO ? \" --to '\" + String($env.REPORT_TO).replace(/'/g, '') + \"'\" : '' }}"
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Run Report CLI",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [220, 100]
    },
    {
      "parameters": {
        "jsCode": "const summaries = JSON.parse($input.first().json.stdout);\nconst lines = summaries.map((s) => {\n  const cents = s.total_revenue_cents;\n  const abs = cents < 0 ? -cents : cents;\n  const rem = abs % 100;\n  const total = `${cents < 0 ? '-' : ''}${(abs - rem) / 100}.${rem < 10 ? '0' : ''}${rem}`;\n  if (s.orders === 0) {\n    return `${s.date}: no sales`;\n  }\n  return `${s.date}: revenue ${total}, orders ${s.orders}, top product ${s.top_product}`;\n});\nreturn [{ json: { text: ['Daily sales report', ...lines].join('\\n') } }];"
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $env.TELEGRAM_CHAT_ID }}" },
            { "name": "text", "value": "={{ $json.text }}" }
          ]
        },
        "options": {}
      },
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 100]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Run Report CLI", "type": "main", "index": 0 }]]
    },
    "Schedule Trigger": {
      "main": [[{ "node": "Run Report CLI", "type": "main", "index": 0 }]]
    },
    "Run Report CLI": {
      "main": [[{ "node": "Format Message", "type": "main", "index": 0 }]]
    },
    "Format Message": {
      "main": [[{ "node": "Send Telegram", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "Europe/Chisinau" },
  "pinData": {}
}
